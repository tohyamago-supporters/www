---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Container from '~/components/Container.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import Card from '~/components/Card.astro'
import Button from '~/components/Button.astro'

// 行動指針。原文のまま 3 項目を並べ、「三つの実」(深緑 → 陽光 → コーラル) の
// 並びに合わせてカード上辺の色を変える。
const principles = [
  {
    body: '地道な実践を積み重ね、社会全体の最適化を見据える',
    accent: 'border-t-primary-soft',
  },
  {
    body: '現実を直視し、多様な立場と事情を尊重する',
    accent: 'border-t-sunlight',
  },
  {
    body: '関係者相互が対等な関係を築き、健全な距離感を保つ',
    accent: 'border-t-accent',
  },
]
---

<BaseLayout
  title="活動方針"
  description="遠山郷応援会の活動方針。なぜ遠山郷の景観・暮らし・文化を守り継ぐのか、私たちの理念と設立趣旨をご紹介します。"
>
  <!-- ヒーロー: 理念そのものをページの第一声 (h1) に置く。
       ページ名は「活動理念」のピルで示し、カードには入れず地色の上に大きく掲げる。 -->
  <section
    class="relative overflow-hidden border-b border-primary/10 bg-gradient-to-b from-sunlight-soft/40 via-base to-base px-4 pt-12 pb-12 text-center sm:pt-16"
  >
    <Container>
      <span
        class="mx-auto mb-5 flex w-fit items-center rounded-full bg-primary-deep px-4 py-1 font-serif text-sm tracking-wide text-white"
      >
        活動理念
      </span>
      <h1
        class="font-serif text-2xl font-medium leading-snug text-primary sm:text-3xl md:text-4xl md:leading-[1.4]"
      >
        <span class="inline-block">都市と地方が</span><span class="inline-block"
          >互いを理解し、</span
        ><span class="inline-block">共に汗を流し、</span><span
          class="inline-block">豊かさを未来へ継ぐ</span
        >
      </h1>
    </Container>
  </section>

  <!-- 行動指針: 判断のよりどころを 3 枚のカードで並べ、迷わず読めるようにする -->
  <Container size="wide" class="py-12 md:py-16">
    <SectionHeading as="h2" align="left" class="mb-6">行動指針</SectionHeading>
    <ol class="grid gap-4 md:grid-cols-3">
      {
        principles.map((principle, i) => (
          <li>
            <Card
              class={`flex h-full gap-4 border-t-4 px-6 py-6 md:px-7 ${principle.accent}`}
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-deep font-serif font-medium text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <p class="text-left leading-loose text-body">{principle.body}</p>
            </Card>
          </li>
        ))
      }
    </ol>
  </Container>

  <!-- 設立趣旨: 読み物としてまとまった量があるため、カードに入れず地色の上にベタ書きする -->
  <Container class="border-t border-primary/10 py-12 md:py-16">
    <SectionHeading as="h2" align="left" class="mb-6">設立趣旨</SectionHeading>
    <div class="space-y-6 leading-loose text-body">
      <p class="indent-4">
        資本主義経済の発展に伴い都市への人口流入が多くなり、それ以外の地域で人口減少や経済活動の衰退が進む傾向は、自由経済圏の各国が抱える共通の課題であるようです。人口や経済活動の一極集中は、都市部においても地方においても生活水準の維持、災害リスクの分散、治安の維持や国防を困難にするものであり、地方の活力を維持することは健全な国土の管理や発展に不可欠であると言えます。人口が減少し資本が流出してしまう地域の生活や産業を守るためには、地域内における事業の継続や発展の工夫を重ねると共に、流出した資本が生んだ都市部の余剰資本を地域に還元し、国全体で格差の少ない均衡の取れた発展を目指す必要があります。
      </p>
      <p class="indent-4">
        遠山郷は魅力的な自然環境や文化を持ち、かつては農林業を中心に栄えた地域でありながら、人口が大きく減少し経済活動が困難になりつつある地域の一つです。平地こそ少ないものの多種の農作物の生育に適した気候で、良好な居住環境が得られ、南方の地域と往来しやすく、赤石山脈西麓への出入口でもあるこの地域を荒廃させて良いとは思えません。
      </p>
      <p class="indent-4">
        地域の経済や文化を守り後世に豊かな社会を残すため、自律継続的に人口の維持と経済活動の発展が行われる仕組みを目指すことが私たちの活動の基本です。具体的には、地域経済の基盤となるべき農地や山林の維持保全、地域内にある価値の可視化や価値の創出による事業化、地域の魅力や課題の情報発信等です。これらの活動は、地域住民だけでなく都市部に住む人々が地域の課題を自らに係るものと捉えて主体的に取り組めることが望ましく、地域内外で相互に無理なく協力し合える環境を作っていきたいです。
      </p>
      <p class="indent-4">
        会員及び関係者においては、より豊かな社会の追求を通じて同時に個々人の幸福を実現されることを願います。
      </p>
    </div>

    <!-- 次の一歩: 読み終えた人が迷わないよう、参加と支援の導線を末尾に置く -->
    <section
      class="mt-12 rounded-3xl border border-primary/10 bg-gradient-to-br from-sunlight-soft/60 to-surface px-6 py-10 text-center md:px-12"
    >
      <SectionHeading as="h2" align="center" class="mb-4"
        >この理念を、かたちにする</SectionHeading
      >
      <p class="mx-auto max-w-xl leading-loose text-body">
        理念を進めるのは、現地で動く人と、遠くから支える人です。どちらの一歩も、遠山郷の暮らしを次の世代へつなぐ力になります。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/join">活動に参加する</Button>
        <Button href="/support" variant="outline">活動を支える</Button>
      </div>
    </section>
  </Container>
</BaseLayout>
