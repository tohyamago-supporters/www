---
/**
 * /achievements — 活動成果。
 *
 * ナビの「活動成果」章の表紙。実績データを羅列するのではなく、当会の活動が
 * 何をもたらしているのかを **切り口ごと**にまとめる。柱は二つ。
 *   1. 遊休農地の活用に参加し、景観の維持に貢献していること
 *   2. ボランティア募集を通じて地域外の関心を集め、交流が生まれていること
 * 成果品とショップでの販売は、その活動から生まれたものとして後段に置く。
 *
 * **具体的な数値 (回数・参加人数・面積・売上など) はこのページに載せない**。
 * 年度ごとに変わる値であり、正確な実績は事業報告書が持つため (附記で案内する)。
 * 法人化前 (任意団体「下栗応援サークル」) の活動は概要で触れるにとどめる。
 */
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import BlurImage from '~/components/BlurImage.astro'
import Container from '~/components/Container.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import Card from '~/components/Card.astro'
import Button from '~/components/Button.astro'
import { PRODUCT_SHOWCASE, resolveProducts } from '~/components/productShowcase'
import farmImage from '~/assets/farm.jpg'
import mountsImage from '~/assets/mounts.jpg'

const SHOP_URL = 'https://shop.tohyamago.org'
const ACTIVO_URL = 'https://activo.jp/s/a/119414'
/** 一般社団法人遠山郷応援会の設立日。 */
const INCORPORATED = '2024年10月1日（令和6年10月1日）'

// 作物の名称・絵文字・基調色は crops コレクションを単一の情報源とする。
const crops = (await getCollection('crops')).map((entry) => ({
  id: entry.id,
  ...entry.data,
}))
const cropList = [...crops].sort((a, b) => a.order - b.order)
const products = resolveProducts(PRODUCT_SHOWCASE, crops)

// 本文の柱。概要の見出しカードと各章で同じ文言を使う。
const pillars = [
  {
    anchor: '#farmland',
    label: '遊休農地の活用と、景観の維持',
    lead: '耕す人がいなくなれば失われてしまう畑に通い、遠山郷の景観を残すこと。',
  },
  {
    anchor: '#exchange',
    label: '地域外からの関心と、人の交流',
    lead: 'ボランティア募集をきっかけに人が訪れ、参加者どうし・地域の人との交流が生まれること。',
  },
]

const anchorLink =
  'font-medium text-accent-strong underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent'
---

<BaseLayout
  title="活動成果"
  description="一般社団法人遠山郷応援会の活動成果。遊休農地の活用による遠山郷の景観維持と、ボランティア募集を通じて生まれている地域内外の交流を、二つの切り口からご紹介します。"
  image={farmImage}
  imageAlt="遠山郷の畑と山並み"
>
  <!-- 表紙: 何についての報告かを先に言い切る -->
  <section class="bg-gradient-to-b from-sunlight-soft/40 via-base to-base">
    <Container size="wide" class="pt-12 pb-10 md:pt-16">
      <p
        class="mb-4 flex w-fit items-center rounded-full bg-primary-deep px-4 py-1 font-serif text-sm tracking-wide text-white"
      >
        活動成果
      </p>
      <h1
        class="font-serif text-3xl font-medium leading-snug text-primary md:text-4xl"
      >
        畑と地域に、積み重ねてきたもの
      </h1>
      <span class="mt-3 block h-1 w-16 rounded-full bg-sunlight"></span>
      <p class="mt-6 max-w-3xl leading-loose text-body">
        一般社団法人遠山郷応援会の活動が、遠山郷に何をもたらしているのか。実績の数字を並べるのではなく、二つの切り口からご報告します。
      </p>
      <div class="mt-8">
        <BlurImage
          src={farmImage}
          alt="遠山郷の急斜面に広がる畑と山並み"
          loading="eager"
          fetchpriority="high"
          fade={false}
          sizes="(min-width: 1280px) 1152px, 100vw"
          class="aspect-[21/9] w-full overflow-hidden rounded-3xl shadow-sm ring-1 ring-primary/10"
          imgClass="h-full! w-full object-cover"
        />
      </div>
    </Container>
  </section>

  <Container size="wide" class="py-12 md:py-16">
    <!-- 1. 概要: 経緯を一言添え、以降の二つの柱を先に示す -->
    <section class="mb-16">
      <SectionHeading as="h2" align="left" class="mb-4">1. 概要</SectionHeading>
      <div class="max-w-3xl space-y-4 leading-loose text-body">
        <p>
          当法人は{
            INCORPORATED
          }に設立され、任意団体である下栗応援サークルが行っていた、ボランティアによる遊休農地の活用と成果品の販売を引き継ぎました。それ以前の経緯は<a
            href="/story"
            class={anchorLink}>遠山郷との始まり</a
          >でご紹介しています。
        </p>
        <p>
          活動そのものは畑仕事が中心ですが、そこから生まれている成果は大きく二つに分けられます。
        </p>
      </div>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {
          pillars.map((pillar, index) => (
            <li class="md:flex">
              <Card class="flex w-full flex-col gap-2 border-t-4 border-t-sunlight px-6 py-6">
                <p class="font-serif text-sm text-primary-deep">
                  成果 {['ひとつめ', 'ふたつめ'][index]}
                </p>
                <h3 class="font-serif text-xl font-medium text-primary">
                  <a href={pillar.anchor} class="hover:underline">
                    {pillar.label}
                  </a>
                </h3>
                <p class="text-left leading-loose text-body">{pillar.lead}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 2. 遊休農地の活用と景観の維持 -->
    <section id="farmland" class="mb-16 scroll-mt-24">
      <SectionHeading as="h2" align="left" class="mb-4"
        >2. 遊休農地の活用と、景観の維持</SectionHeading
      >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div class="max-w-3xl space-y-4 leading-loose text-body">
          <p>
            遠山郷・下栗の里の畑は、標高 1,000m
            前後の急傾斜地に石垣を積んで拓かれたものです。機械が入りにくく、担い手の高齢化とともに耕されない土地が増えています。ひとたび手が入らなくなれば、数年で草木に覆われ、山に還ってしまいます。
          </p>
          <p>
            当会は、こうした遊休農地の活用に地域の一員として参加しています。春の植え付けから夏の草取り、秋の収穫と脱穀、冬を越しての整枝・施肥まで、年間を通じて畑に通い続けること。その積み重ねが、「日本のチロル」とも呼ばれる下栗の景観を、現在の姿のまま次の年へ渡すことにつながっています。
          </p>
          <p>
            守っているのは風景だけではありません。この土地で代々受け継がれてきた在来の作物も、畑を耕し続けることで途切れずに残っています。
          </p>
          <ul class="flex flex-wrap gap-2 pt-1" aria-label="畑で育てている作物">
            {
              cropList.map((crop) => (
                <li
                  class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm text-primary-deep"
                  style={`background-color: color-mix(in srgb, ${crop.color} 16%, transparent)`}
                >
                  {crop.emoji && <span aria-hidden="true">{crop.emoji}</span>}
                  {crop.name}
                </li>
              ))
            }
          </ul>
          <div class="flex flex-wrap gap-3 pt-2">
            <Button href="/calendar" variant="outline">畑の一年を見る</Button>
            <Button href="/news" variant="outline">活動記録を読む</Button>
          </div>
        </div>
        <BlurImage
          src={mountsImage}
          alt="遠山郷の山並みと里の風景"
          sizes="(min-width: 1024px) 448px, 100vw"
          class="aspect-[4/3] w-full overflow-hidden rounded-3xl shadow-sm ring-1 ring-primary/10 lg:aspect-auto lg:h-full"
          imgClass="h-full! w-full object-cover"
        />
      </div>
    </section>

    <!-- 3. 地域外からの関心と交流 -->
    <section id="exchange" class="mb-16 scroll-mt-24">
      <SectionHeading as="h2" align="left" class="mb-4"
        >3. 地域外からの関心と、人の交流</SectionHeading
      >
      <div class="max-w-3xl space-y-4 leading-loose text-body">
        <p>
          農作業はボランティアとして広く募集しています。遠山郷を知らなかった人、名前は聞いたことがあっても訪れる機会のなかった人が、「畑を手伝う」という具体的な用事を通じて、この土地に足を運ぶきっかけになっています。
        </p>
        <p>
          そして畑に立てば、初対面どうしでも自然と会話が生まれます。同じ作業を分担し、収穫の手応えを分かち合う時間は、参加者どうしのつながりを残していきます。作業のやり方や畑の来歴を地域の方に教わり、地域の行事に加えていただく機会もあります。こうして、外から訪れた人と地域に暮らす人との行き来が、少しずつ重なってきました。
        </p>
        <p>
          一度きりで終わらず、季節を変えてまた訪れる人がいること。遠山郷を気にかける人が地域の外にも増えていること自体を、私たちは活動の成果と考えています。
        </p>
      </div>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          [
            {
              title: '訪れるきっかけをつくる',
              body: 'ボランティア募集を通じて、遠山郷を訪れる理由と受け入れの窓口を用意しています。',
            },
            {
              title: '参加者どうしがつながる',
              body: '同じ畑で作業を分担する時間が、初めて会った人どうしの関係を残します。',
            },
            {
              title: '地域の人と行き来する',
              body: '作業を教わり、地域の行事に加えていただくなかで、内と外の交流が続いています。',
            },
          ].map((item) => (
            <li class="md:flex">
              <Card class="flex w-full flex-col gap-2 px-6 py-6">
                <h3 class="font-serif text-lg font-medium text-primary">
                  {item.title}
                </h3>
                <p class="text-left leading-loose text-body">{item.body}</p>
              </Card>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/join">はじめての方へ</Button>
        <Button href={ACTIVO_URL} variant="outline"
          >ボランティア募集を見る</Button
        >
      </div>
    </section>

    <!-- 4. 成果品: 活動から生まれたものとして、章の一部に置く -->
    <section class="mb-16">
      <SectionHeading as="h2" align="left" class="mb-4"
        >4. 活動から生まれた成果品</SectionHeading
      >
      <p class="mb-6 max-w-3xl leading-loose text-body">
        作物を売るために畑を耕しているわけではありませんが、畑仕事を続ければ実りもついてきます。収穫したものを手を加えてお分けすることは、活動を知っていただく入口であり、耕作を続けていく力にもなります。
      </p>
      <ul class="mb-6 grid gap-4 sm:grid-cols-2">
        {
          products.map((product) => (
            <li class="sm:flex">
              <Card class="flex w-full items-start gap-4 px-5 py-5">
                {product.emoji && (
                  <span
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-2xl"
                    style={`background-color: color-mix(in srgb, ${product.color} 15%, transparent)`}
                    aria-hidden="true"
                  >
                    {product.emoji}
                  </span>
                )}
                <div>
                  <h3 class="font-serif text-lg font-medium text-primary">
                    {product.name}
                  </h3>
                  <p class="mt-1 text-left text-sm leading-relaxed text-body/80">
                    {product.tagline}
                  </p>
                  <p class="mt-2 text-left text-sm text-body">
                    {product.makes.map((make) => make.label).join('／')}
                  </p>
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap gap-3">
        <Button href="/products">成果品を詳しく見る</Button>
        <Button href={SHOP_URL} variant="outline">オンラインショップ</Button>
      </div>
    </section>

    <!-- 5. 附記: 数値の在り処と、関連する記録への導線 -->
    <section class="mb-16">
      <SectionHeading as="h2" align="left" class="mb-4">5. 附記</SectionHeading>
      <ul
        class="max-w-3xl list-disc space-y-2 pl-5 text-left leading-loose text-body marker:text-primary-soft"
      >
        <li>
          このページは活動の成果を切り口ごとにまとめたものです。事業年度ごとの実施回数・参加人数・販売状況といった数値は年度によって変わるため、ここには掲載せず、総会に提出する事業報告書に記載しています。
        </li>
        <li>
          一日ごとの作業の様子や写真は<a href="/news" class={anchorLink}
            >活動記録</a
          >、作物ごとの年間の流れは<a href="/calendar" class={anchorLink}
            >農作業カレンダー</a
          >でご覧いただけます。
        </li>
        <li>
          法令に基づく公告は<a href="/public_notices" class={anchorLink}>公告</a
          >のページに掲載します。
        </li>
      </ul>
    </section>

    <!-- 次の一歩: 成果は参加した人の時間の積み重ね、という締め -->
    <section
      class="rounded-3xl border border-primary/10 bg-gradient-to-br from-sunlight-soft/60 to-surface px-6 py-10 text-center md:px-12"
    >
      <SectionHeading as="h2" align="center" class="mb-4"
        >この続きを、一緒に</SectionHeading
      >
      <p
        class="mx-auto max-w-xl text-left leading-loose text-body sm:text-center"
      >
        ここに書いた成果は、畑に集まったいろいろな人が過ごした時間の積み重ねです。次の一年ぶんを増やすのは、これから加わる人の一日。まずは一日、活動に加わってみませんか。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/join">はじめての方へ</Button>
        <Button href="/support" variant="outline">活動を寄付で支える</Button>
      </div>
    </section>
  </Container>
</BaseLayout>
